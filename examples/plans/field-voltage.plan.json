{
  "format": "instrument-workbench-plan",
  "version": 1,
  "name": "Field-voltage joint scan",
  "preparations": [
    {
      "device": "k2450",
      "function": "Voltage",
      "level": {
        "value": 0,
        "unit": "Volt"
      },
      "compliance": {
        "value": 0.000105,
        "unit": "Ampere"
      },
      "sense": {
        "function": "Current",
        "mode": "FourWire",
        "nplc": 1,
        "autoRange": true
      }
    }
  ],
  "metadata": {
    "field_points": {
      "value": 3,
      "unit": "Dimensionless"
    },
    "voltage_points": {
      "value": 5,
      "unit": "Dimensionless"
    }
  },
  "root": {
    "id": "experiment",
    "kind": "sequence",
    "children": [
      {
        "id": "source_on",
        "kind": "output",
        "device": "k2450",
        "enabled": true
      },
      {
        "id": "field_scan",
        "kind": "scan",
        "axis": {
          "device": "field",
          "parameter": "field.target"
        },
        "column": "field_axis",
        "values": {
          "unit": "Tesla",
          "values": [
            0,
            0.01,
            0.02
          ]
        },
        "dwellSeconds": 0,
        "body": {
          "id": "field_body",
          "kind": "sequence",
          "children": [
            {
              "id": "field_stable",
              "kind": "wait_stable",
              "readback": {
                "device": "field",
                "parameter": "field.readback"
              },
              "target": {
                "variable": "field_axis"
              },
              "tolerance": {
                "value": 0.0001,
                "unit": "Tesla"
              },
              "stableSeconds": 0.05,
              "pollSeconds": 0.05,
              "timeoutSeconds": 5
            },
            {
              "id": "voltage_scan",
              "kind": "scan",
              "axis": {
                "device": "k2450",
                "parameter": "k2450.source_voltage"
              },
              "column": "voltage_axis",
              "values": {
                "unit": "Volt",
                "values": [
                  -0.02,
                  -0.01,
                  0,
                  0.01,
                  0.02
                ]
              },
              "dwellSeconds": 0.3,
              "body": {
                "id": "joint_read",
                "kind": "read",
                "channels": [
                  {
                    "column": "current",
                    "address": {
                      "device": "k2450",
                      "parameter": "k2450.measured_current"
                    }
                  },
                  {
                    "column": "field_readback",
                    "address": {
                      "device": "field",
                      "parameter": "field.readback"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
