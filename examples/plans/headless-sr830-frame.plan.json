{
  "format": "instrument-workbench-plan",
  "version": 1,
  "name": "Passive SR830 raw frames",
  "preparations": [],
  "metadata": {},
  "root": {
    "kind": "sequence",
    "id": "root",
    "children": [
      {
        "kind": "set",
        "id": "input",
        "address": {
          "device": "sr830",
          "parameter": "sr830.input_mode"
        },
        "value": {
          "constant": {
            "value": 1,
            "unit": "Dimensionless"
          }
        }
      },
      {
        "kind": "set",
        "id": "sensitivity",
        "address": {
          "device": "sr830",
          "parameter": "sr830.sensitivity_register"
        },
        "value": {
          "constant": {
            "value": 0.005,
            "unit": "Volt"
          }
        }
      },
      {
        "kind": "set",
        "id": "time",
        "address": {
          "device": "sr830",
          "parameter": "sr830.time_constant"
        },
        "value": {
          "constant": {
            "value": 0.3,
            "unit": "Second"
          }
        }
      },
      {
        "kind": "set",
        "id": "slope",
        "address": {
          "device": "sr830",
          "parameter": "sr830.filter_slope"
        },
        "value": {
          "constant": {
            "value": 18,
            "unit": "Dimensionless"
          }
        }
      },
      {
        "kind": "for_each",
        "id": "repeat",
        "variable": "iteration",
        "values": {
          "unit": "Dimensionless",
          "values": [
            1,
            2,
            3
          ]
        },
        "body": {
          "kind": "read_sr830_frame",
          "id": "frame",
          "device": "sr830",
          "input": "VoltageAB",
          "prefix": "raw"
        }
      }
    ]
  }
}
