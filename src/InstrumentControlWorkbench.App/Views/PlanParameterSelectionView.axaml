<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InstrumentControlWorkbench.App.ViewModels"
             x:Class="InstrumentControlWorkbench.App.Views.PlanParameterSelectionView" x:DataType="vm:PlanParameterSelectionViewModel">
  <StackPanel Spacing="6">
    <TextBlock Text="设备" Classes="caption"/>
    <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" IsEnabled="{Binding !IsReadOnly}" HorizontalAlignment="Stretch" AutomationProperties.Name="表单设备">
      <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:PlanDeviceChoice"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontSize="11"/></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox>
    <TextBlock Text="参数" Classes="caption"/>
    <ComboBox ItemsSource="{Binding Parameters}" SelectedItem="{Binding SelectedParameter, Mode=TwoWay}" IsEnabled="{Binding !IsReadOnly}" HorizontalAlignment="Stretch" AutomationProperties.Name="表单参数">
      <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:PlanParameterChoice"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontSize="11"/></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox>
    <TextBlock Text="{Binding Constraint}" Classes="caption" FontSize="10" TextWrapping="Wrap"/>
  </StackPanel>
</UserControl>
