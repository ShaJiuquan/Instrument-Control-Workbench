<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:InstrumentControlWorkbench.App.ViewModels"
 x:Class="InstrumentControlWorkbench.App.Views.PlanEnvironmentFormView" x:DataType="vm:PlanEnvironmentFormViewModel">
 <Expander Header="环境读数绑定" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" FontSize="11">
  <ItemsControl ItemsSource="{Binding Entries}" Margin="0,8,0,0">
   <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PlanEnvironmentReadFormViewModel">
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8">
     <StackPanel Spacing="6">
      <CheckBox Content="{Binding Label}" IsChecked="{Binding IsIncluded, Mode=TwoWay}" IsEnabled="{Binding !IsReadOnly}" AutomationProperties.Name="{Binding Label}"/>
      <TextBlock Text="结果列 ID" Classes="caption"/><TextBox Text="{Binding Column, Mode=TwoWay}" IsReadOnly="{Binding !CanEdit}" AutomationProperties.Name="环境结果列"/>
      <CheckBox Content="绑定控制器实际读回" IsChecked="{Binding BindController, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="绑定环境控制器"/>
      <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedController, Mode=TwoWay}" IsEnabled="{Binding CanSelectController}" HorizontalAlignment="Stretch" AutomationProperties.Name="环境读回控制器">
       <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:PlanEnvironmentAxisChoice"><TextBlock Text="{Binding Label}" FontSize="11" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock Text="{Binding BindingSummary}" Classes="caption" FontSize="10" TextWrapping="Wrap"/>
     </StackPanel>
    </Border>
   </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
 </Expander>
</UserControl>
