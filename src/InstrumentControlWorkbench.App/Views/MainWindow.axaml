<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:InstrumentControlWorkbench.App.ViewModels" xmlns:views="using:InstrumentControlWorkbench.App.Views"
        x:Class="InstrumentControlWorkbench.App.Views.MainWindow" x:DataType="vm:MainWindowViewModel"
        Title="Instrument Workbench" Width="1440" Height="900" MinWidth="1060" MinHeight="720"
        FontFamily="avares://Avalonia.Fonts.Inter/Assets#Inter" Background="{DynamicResource Workspace}">
  <Grid ColumnDefinitions="188,*">
    <views:ShellNavigation/>
    <Grid Grid.Column="1" RowDefinitions="54,*,28">
      <Border Background="White" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="24,0">
        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="16">
            <TextBlock Text="Workspace" Classes="secondary"/><TextBlock Text="/" Foreground="#C1C8D5"/>
            <TextBlock Text="{Binding PageTitle}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Classes="badge" Classes.connected="{Binding Connected}"><TextBlock Text="{Binding ConnectionText}"/></Border>
            <Border Classes="badge"><TextBlock Text="DEMO MODE"/></Border>
            <Border Background="{DynamicResource AccentSoft}" CornerRadius="14" Width="28" Height="28" Margin="8,0,0,0"><TextBlock Text="IW" FontSize="10" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" Margin="24,22,24,20">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding PageTitle}" FontSize="24" FontWeight="Normal"/>
            <TextBlock Text="{Binding PageDescription}" Classes="secondary" FontSize="12"/>
          </StackPanel>
          <Button Grid.Column="1" Command="{Binding OpenDataCommand}" Content="查看采集数据  →" VerticalAlignment="Top" Margin="0,4,0,0" IsVisible="{Binding IsMeasurementPage}"/>
        </Grid>
        <Border Grid.Row="1" IsVisible="{Binding HasOperationError}" Background="#FFF1EF" Padding="14,10" CornerRadius="5" Margin="0,0,0,14">
          <TextBlock Text="{Binding OperationError}" Classes="error"/>
        </Border>
        <Grid Grid.Row="2">
          <Grid IsVisible="{Binding IsMeasurementPage}" RowDefinitions="96,16,*">
            <views:ReadoutStripView/>
            <Grid Grid.Row="2" ColumnDefinitions="*,16,282">
              <views:RunMonitorView/>
              <views:MeasurementSetupView Grid.Column="2"/>
            </Grid>
          </Grid>
          <views:InstrumentView IsVisible="{Binding IsInstrumentsPage}"/>
          <views:RunDataView IsVisible="{Binding IsDataPage}"/>
          <views:EventLogView IsVisible="{Binding IsEventsPage}"/>
        </Grid>
      </Grid>
      <Border Grid.Row="2" Background="White" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="20,0">
        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
          <TextBlock Text="●  SIMULATOR" Foreground="#199E74" FontSize="9" Margin="0,0,14,0"/>
          <TextBlock Grid.Column="1" Text="{Binding LastEvent}" Classes="caption" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,0,24,0"/>
          <TextBlock Grid.Column="2" Text="{Binding SafetyText}" Classes="caption" FontSize="10"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
