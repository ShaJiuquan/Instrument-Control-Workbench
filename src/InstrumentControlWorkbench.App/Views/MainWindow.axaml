<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:InstrumentControlWorkbench.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1580" d:DesignHeight="980"
        x:Class="InstrumentControlWorkbench.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Instrument Control Workbench"
        Width="1580" Height="980"
        MinWidth="1280" MinHeight="820"
        FontFamily="Inter, SF Pro, Segoe UI, Arial"
        Background="#EEF2F6">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <SolidColorBrush x:Key="BgApp" Color="#EEF2F6"/>
        <SolidColorBrush x:Key="BgPanel" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BgSubtle" Color="#F7F9FC"/>
        <SolidColorBrush x:Key="BgSelected" Color="#EAF2FF"/>
        <SolidColorBrush x:Key="Border" Color="#D9E0EA"/>
        <SolidColorBrush x:Key="BorderStrong" Color="#C8D2DE"/>
        <SolidColorBrush x:Key="TextMain" Color="#111827"/>
        <SolidColorBrush x:Key="TextSub" Color="#667085"/>
        <SolidColorBrush x:Key="TextMuted" Color="#98A2B3"/>
        <SolidColorBrush x:Key="Accent" Color="#1E6BB8"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#DCEBFA"/>
        <SolidColorBrush x:Key="Ok" Color="#079455"/>
        <SolidColorBrush x:Key="OkSoft" Color="#DDF8E8"/>
        <SolidColorBrush x:Key="Warn" Color="#B54708"/>
        <SolidColorBrush x:Key="WarnSoft" Color="#FEF0C7"/>
        <SolidColorBrush x:Key="Err" Color="#D92D20"/>
        <SolidColorBrush x:Key="ErrSoft" Color="#FEE4E2"/>
        <SolidColorBrush x:Key="DarkPanel" Color="#101828"/>
        <FontFamily x:Key="Mono">Menlo, Consolas, SF Mono, monospace</FontFamily>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource TextSub}"/>
        </Style>
        <Style Selector="TextBlock.kicker">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="{DynamicResource Mono}"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{DynamicResource Err}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="54,*,210,26">
        <Border Grid.Row="0" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="12,0" ColumnSpacing="16">
                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource Accent}">
                        <TextBlock Text="IC" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding AppTitle}" FontSize="15" FontWeight="SemiBold"/>
                </StackPanel>

                <Border Grid.Column="1" Width="1" Height="28" Background="{DynamicResource Border}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                    <StackPanel Spacing="1">
                        <TextBlock Text="{Binding WorkspaceName}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding WorkspaceSubtitle}" Classes="muted" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource Ok}"/>
                        <TextBlock Text="backend" Classes="muted"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource Ok}"/>
                        <TextBlock Text="notify" Classes="muted"/>
                    </StackPanel>
                    <Border Background="#EDF1F5" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="7" Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding RunningCount}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding QueuedCount}" Classes="muted"/>
                            <TextBlock Text="{Binding FailedCount}" Foreground="{DynamicResource Err}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Import"/>
                    <Button Content="Export"/>
                    <Button Classes="primary" Content="Run Workflow" Command="{Binding StartRunCommand}"/>
                    <Button Classes="danger" Content="Emergency Off" Command="{Binding AbortRunCommand}"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Copilot"/>
                    <Button Content="Bell"/>
                    <Button Content="Settings"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="220,*,360" ColumnSpacing="0">
            <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Bottom" Margin="10" Padding="10" CornerRadius="8" Background="#E8EEF5">
                        <StackPanel Spacing="5">
                            <TextBlock Text="STORAGE" Classes="kicker"/>
                            <TextBlock Text="workspace.db - 6.4 MB" Classes="mono" Foreground="{DynamicResource TextSub}" FontSize="12"/>
                            <ProgressBar Height="6" Minimum="0" Maximum="100" Value="26"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer>
                        <StackPanel Margin="0,10" Spacing="14">
                            <TextBlock Text="WORKSPACE" Classes="kicker" Margin="14,0,0,0"/>
                            <ItemsControl ItemsSource="{Binding WorkspaceNav}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:NavItem">
                                        <Border Background="{DynamicResource BgSelected}" Padding="0">
                                            <Grid Height="32" ColumnDefinitions="4,34,*,Auto">
                                                <Border Grid.Column="0" Background="{DynamicResource Accent}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Glyph}" HorizontalAlignment="Center" Foreground="{DynamicResource Accent}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Label}" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Count}" Classes="muted" Margin="0,0,14,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="CONTROL" Classes="kicker" Margin="14,0,0,0"/>
                            <ItemsControl ItemsSource="{Binding ControlNav}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:NavItem">
                                        <Grid Height="32" ColumnDefinitions="34,*,Auto" Margin="0,0,0,0">
                                            <TextBlock Grid.Column="0" Text="{Binding Glyph}" HorizontalAlignment="Center" Foreground="{DynamicResource TextSub}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="{DynamicResource TextSub}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Count}" Classes="muted" Margin="0,0,14,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="DATA" Classes="kicker" Margin="14,0,0,0"/>
                            <ItemsControl ItemsSource="{Binding DataNav}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:NavItem">
                                        <Grid Height="32" ColumnDefinitions="34,*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Glyph}" HorizontalAlignment="Center" Foreground="{DynamicResource TextSub}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="{DynamicResource TextSub}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Count}" Classes="muted" Margin="0,0,14,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="SYSTEM" Classes="kicker" Margin="14,0,0,0"/>
                            <ItemsControl ItemsSource="{Binding SystemNav}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:NavItem">
                                        <Grid Height="32" ColumnDefinitions="34,*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Glyph}" HorizontalAlignment="Center" Foreground="{DynamicResource TextSub}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="{DynamicResource TextSub}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Count}" Classes="muted" Margin="0,0,14,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,*,270" Margin="22,20,22,16" RowSpacing="14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="Instruments" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="devices, roles, leases, and control surfaces" Classes="muted" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <TextBox Width="260" Watermark="Search instruments"/>
                        <Button Content="Add instrument"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding Instruments}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="300" ItemHeight="154"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:InstrumentCard">
                                <Border Margin="0,0,14,14" Padding="14" Background="{DynamicResource BgPanel}"
                                        BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8">
                                    <Grid RowDefinitions="Auto,*,Auto">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Width="34" Height="34" Background="{DynamicResource AccentSoft}" CornerRadius="7">
                                                <TextBlock Text="{Binding Role}" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Id}" Classes="mono" Foreground="{DynamicResource TextSub}"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="{DynamicResource BgSubtle}" CornerRadius="999" Padding="8,3">
                                                <TextBlock Text="{Binding State}" FontSize="11" Foreground="{DynamicResource TextSub}"/>
                                            </Border>
                                        </Grid>

                                        <StackPanel Grid.Row="1" Spacing="4" Margin="0,12,0,0">
                                            <TextBlock Text="{Binding Address}" Classes="mono" Foreground="{DynamicResource TextSub}"/>
                                            <TextBlock Text="{Binding Detail}" Classes="muted"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                                            <Button Content="Connect"/>
                                            <Button Content="Configure"/>
                                            <Button Content="Open"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid Grid.Row="2" ColumnDefinitions="*,360" ColumnSpacing="14">
                    <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Live Plot" FontSize="16" FontWeight="SemiBold"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button Content="Zoom"/>
                                    <Button Content="Pan"/>
                                    <Button Content="Autoscale"/>
                                    <Button Content="Export"/>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="1" Margin="0,10,0,10" Background="#FBFCFE" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6">
                                <Canvas MinHeight="168">
                                    <Rectangle Canvas.Left="38" Canvas.Top="18" Width="620" Height="140" Fill="White" Stroke="#E5E7EB"/>
                                    <Line StartPoint="38,132" EndPoint="658,132" Stroke="#CBD5E1" StrokeThickness="1"/>
                                    <Line StartPoint="38,92" EndPoint="658,92" Stroke="#EEF2F7" StrokeThickness="1"/>
                                    <Line StartPoint="38,52" EndPoint="658,52" Stroke="#EEF2F7" StrokeThickness="1"/>
                                    <Polyline Points="38,138 100,126 162,112 224,96 286,84 348,65 410,52 472,41 534,34 596,29 658,24" Stroke="#1E6BB8" StrokeThickness="3"/>
                                    <Polyline Points="38,144 100,139 162,132 224,121 286,108 348,91 410,75 472,61 534,48 596,38 658,31" Stroke="#079455" StrokeThickness="2"/>
                                </Canvas>
                            </Border>
                            <TextBlock Grid.Row="2" Text="{Binding SourceRangeText}" Classes="muted"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                            <TextBlock Text="Measurement Recipe" FontSize="16" FontWeight="SemiBold"/>
                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding SweepSummary}" Classes="muted"/>
                                <TextBlock Grid.Column="1" Text="{Binding ActiveRunState}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/>
                            </Grid>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                <Button Content="Validate"/>
                                <Button Classes="primary" Content="Start Run" Command="{Binding StartRunCommand}"/>
                                <Button Classes="danger" Content="Abort" Command="{Binding AbortRunCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Column="2" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="16" RowSpacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Selected Instrument" Classes="kicker"/>
                        <TextBlock Text="{Binding InstrumentName}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Identifier}" Classes="muted" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{DynamicResource BgSubtle}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="112,*" RowSpacing="8">
                            <TextBlock Text="Lifecycle" Classes="muted"/>
                            <TextBlock Grid.Column="1" Text="{Binding Lifecycle}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="1" Text="Connection" Classes="muted"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ConnectionState}"/>
                            <TextBlock Grid.Row="2" Text="Output" Classes="muted"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OutputState}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="3" Text="Lease" Classes="muted"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LeaseStatus}"/>
                            <TextBlock Grid.Row="4" Text="Heartbeat" Classes="muted"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LastHeartbeat}" Classes="mono"/>
                        </Grid>
                    </Border>

                    <TabControl Grid.Row="2">
                        <TabItem Header="Status">
                            <StackPanel Spacing="8" Margin="0,10,0,0">
                                <Button Content="Connect" Command="{Binding ConnectCommand}"/>
                                <Button Content="Apply Config"/>
                                <Button Content="Output On"/>
                                <Button Classes="danger" Content="Safe Stop" Command="{Binding AbortRunCommand}"/>
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="Source">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="110,*" RowSpacing="8" ColumnSpacing="8" Margin="0,10,0,0">
                                <TextBlock Text="Function" Classes="muted"/>
                                <TextBlock Grid.Column="1" Text="{Binding SourceFunction}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="1" Text="Start V" Classes="muted"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding StartVoltageText, Mode=TwoWay}"/>
                                <TextBlock Grid.Row="2" Text="Stop V" Classes="muted"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding StopVoltageText, Mode=TwoWay}"/>
                                <TextBlock Grid.Row="3" Text="Compliance" Classes="muted"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ComplianceText, Mode=TwoWay}"/>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Measure">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="110,*" RowSpacing="8" ColumnSpacing="8" Margin="0,10,0,0">
                                <TextBlock Text="Sense" Classes="muted"/>
                                <TextBlock Grid.Column="1" Text="{Binding SenseFunction}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="1" Text="Mode" Classes="muted"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SensingMode}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="2" Text="Points" Classes="muted"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SweepPointsText, Mode=TwoWay}"/>
                                <TextBlock Grid.Row="3" Text="Dwell" Classes="muted"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DwellSecondsText, Mode=TwoWay}"/>
                            </Grid>
                        </TabItem>
                    </TabControl>

                    <Border Grid.Row="3" Background="{DynamicResource DarkPanel}" CornerRadius="8" Padding="14">
                        <Grid RowDefinitions="Auto,Auto,Auto">
                            <TextBlock Text="SOURCE" Foreground="#98A2B3" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="1" Text="{Binding SourceLevelDisplay}" Foreground="White" FontFamily="{DynamicResource Mono}" FontSize="34" FontWeight="Bold"/>
                            <TextBlock Grid.Row="2" Text="{Binding LatestReading}" Foreground="#A7F3D0" FontFamily="{DynamicResource Mono}" FontSize="18" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="4" Background="{DynamicResource WarnSoft}" CornerRadius="7" Padding="10">
                        <TextBlock Text="UI observes ViewModel state. Drivers are only reached through leases, state machine, and ports." Foreground="{DynamicResource Warn}" TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,1">
            <Grid RowDefinitions="34,*">
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="14,0" ColumnSpacing="16">
                    <TextBlock Text="Jobs" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="Notifications" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="2" Text="Logs" Classes="muted"/>
                    <TextBlock Grid.Column="3" Text="Provenance" Classes="muted"/>
                    <Button Grid.Column="5" Content="Mark read" Padding="8,4"/>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="*,420" ColumnSpacing="14" Margin="14,0,14,12">
                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="10">
                        <Grid RowDefinitions="Auto,*">
                            <Grid ColumnDefinitions="70,*,110,*" Margin="0,0,0,6">
                                <TextBlock Text="STATUS" Classes="kicker"/>
                                <TextBlock Grid.Column="1" Text="JOB" Classes="kicker"/>
                                <TextBlock Grid.Column="2" Text="TYPE" Classes="kicker"/>
                                <TextBlock Grid.Column="3" Text="DETAIL" Classes="kicker"/>
                            </Grid>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Jobs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:JobRow">
                                        <Grid ColumnDefinitions="70,*,110,*" Height="28">
                                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Type}" Classes="muted"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Detail}" Classes="muted"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="10">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding EventLog}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,7"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="#F8FAFC">
            <Grid ColumnDefinitions="*,Auto" Margin="12,0">
                <TextBlock Text="connected - 14ms   workspace: Default lab workspace" Classes="muted" FontSize="12"/>
                <TextBlock Grid.Column="1" Text="{Binding CompletedSummary}" Classes="muted" FontSize="12"/>
            </Grid>
        </Border>
    </Grid>
</Window>
