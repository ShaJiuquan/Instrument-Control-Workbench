<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InstrumentControlWorkbench.App.ViewModels" xmlns:views="using:InstrumentControlWorkbench.App.Views"
             x:Class="InstrumentControlWorkbench.App.Views.InstrumentView" x:DataType="vm:MainWindowViewModel">
  <TabControl>
    <TabItem Header="设备状态" IsVisible="{Binding HasDevices}"><views:DeviceOperatorView DataContext="{Binding Devices}" Margin="0,14,0,0"/></TabItem>
    <TabItem Header="设备设置" IsVisible="{Binding HasSettings}"><views:DeviceSettingsView DataContext="{Binding Settings}" Margin="0,14,0,0"/></TabItem>
  </TabControl>
</UserControl>
