<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InstrumentControlWorkbench.App.ViewModels" xmlns:controls="using:InstrumentControlWorkbench.App.Controls"
             x:Class="InstrumentControlWorkbench.App.Views.PlanNodeEditorView" x:DataType="vm:PlanWorkspaceViewModel">
  <Grid RowDefinitions="Auto,*,Auto" Margin="8">
    <TextBlock Text="{Binding SelectedNodeTitle}" Classes="caption" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
    <TextBox Grid.Row="1" Text="{Binding NodeFragment, Mode=TwoWay}" IsReadOnly="{Binding IsNodeReadOnly}" AcceptsReturn="True" AcceptsTab="True" FontFamily="Menlo,Consolas,monospace" FontSize="11" TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="所选节点参数"/>
    <WrapPanel Grid.Row="2" Margin="0,8,0,0"><controls:OperatorButton Content="应用并验证" Command="{Binding ApplyNodeCommand}" Margin="0,0,8,0" AutomationProperties.Name="应用流程节点"/><controls:OperatorButton Content="撤销节点修改" Command="{Binding DiscardNodeCommand}" AutomationProperties.Name="撤销流程节点"/></WrapPanel>
  </Grid>
</UserControl>
