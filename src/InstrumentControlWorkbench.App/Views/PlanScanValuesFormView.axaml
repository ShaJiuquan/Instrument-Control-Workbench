<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:InstrumentControlWorkbench.App.ViewModels" xmlns:views="using:InstrumentControlWorkbench.App.Views" xmlns:controls="using:InstrumentControlWorkbench.App.Controls"
 x:Class="InstrumentControlWorkbench.App.Views.PlanScanValuesFormView" x:Name="ScanRoot" x:DataType="vm:PlanScanValuesFormViewModel">
 <StackPanel Spacing="8">
  <TextBlock Text="{Binding UnitLabel}" Classes="caption" TextWrapping="Wrap"/>
  <CheckBox Content="分段扫描 / 按列表顺序拼接" IsChecked="{Binding UseSegments, Mode=TwoWay}" IsEnabled="{Binding !IsReadOnly}" AutomationProperties.Name="分段扫描"/>
  <Grid IsVisible="{Binding !UseSegments}"><views:PlanScanRangeFormView DataContext="{Binding Definition}"/></Grid>
  <StackPanel Spacing="8" IsVisible="{Binding UseSegments}">
   <ItemsControl ItemsSource="{Binding Segments}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PlanScanRangeFormViewModel">
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8"><StackPanel Spacing="8">
     <views:PlanScanRangeFormView/>
     <controls:OperatorButton Content="删除分段" Command="{Binding #ScanRoot.((vm:PlanScanValuesFormViewModel)DataContext).RemoveSegmentCommand}" CommandParameter="{Binding}" HorizontalAlignment="Left"/>
    </StackPanel></Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <controls:OperatorButton Content="添加分段" Command="{Binding AddSegmentCommand}" HorizontalAlignment="Left" AutomationProperties.Name="添加扫描分段"/>
   <TextBlock Text="相邻重复值合并；要保留重复点，请使用显式列表。" Classes="caption" FontSize="10" TextWrapping="Wrap"/>
  </StackPanel>
  <controls:OperatorButton Content="预览点数与前 12 个值" Command="{Binding PreviewCommand}" HorizontalAlignment="Left" AutomationProperties.Name="预览扫描点数"/>
  <TextBlock Text="{Binding PreviewText}" Classes="caption" TextWrapping="Wrap"/>
  <TextBlock Text="预览不发送设备命令。应用时仍检查完整计划、资源和执行预算。生成方式在保存后展开为明确的数值列表。" Classes="caption" FontSize="10" TextWrapping="Wrap"/>
 </StackPanel>
</UserControl>
