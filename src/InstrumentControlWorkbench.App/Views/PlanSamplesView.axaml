<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:InstrumentControlWorkbench.App.ViewModels" xmlns:views="using:InstrumentControlWorkbench.App.Views" xmlns:controls="using:InstrumentControlWorkbench.App.Controls"
 x:Class="InstrumentControlWorkbench.App.Views.PlanSamplesView" x:DataType="vm:PlanWorkspaceViewModel">
 <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="8">
  <ComboBox Margin="0,0,0,8" ItemsSource="{Binding SampleChoices}" SelectedItem="{Binding SelectedSample, Mode=TwoWay}" IsEnabled="{Binding CanSelectSample}" HorizontalAlignment="Stretch" AutomationProperties.Name="计划样品">
   <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:PlanSampleChoice"><TextBlock Text="{Binding Label}" FontSize="11" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
  </ComboBox>
  <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
   <controls:OperatorButton Content="配置初始路由" Command="{Binding InitializeRoutingCommand}" IsVisible="{Binding !HasRoutingCatalog}" AutomationProperties.Name="配置初始路由"/>
   <controls:OperatorButton Content="新建样品" Command="{Binding CreateSampleCommand}" IsVisible="{Binding HasRoutingCatalog}" AutomationProperties.Name="新建样品"/>
   <controls:OperatorButton Content="移除未使用样品" Command="{Binding RemoveSampleCommand}" IsVisible="{Binding HasRoutingCatalog}" AutomationProperties.Name="移除计划样品"/>
  </StackPanel>
  <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="10">
   <controls:OperatorButton Content="编辑通道与接线" Command="{Binding EditRoutingCatalogCommand}" IsVisible="{Binding HasRoutingCatalog}" HorizontalAlignment="Left" AutomationProperties.Name="编辑通道与接线"/>
   <Grid IsVisible="{Binding EditingRoutingCatalog}"><views:PlanRoutingCatalogFormView DataContext="{Binding RoutingCatalogForm}"/></Grid>
   <StackPanel IsVisible="{Binding IsExistingSample}" Spacing="10">
    <TextBlock IsVisible="{Binding !HasSampleForm}" Text="可配置初始目录或导入档案；需先在设备配置中注册矩阵与源。" Classes="caption" TextWrapping="Wrap"/>
    <Grid IsVisible="{Binding HasSampleForm}"><views:PlanSampleDetailsFormView DataContext="{Binding SampleForm}"/></Grid>
    <Expander Header="电极映射" IsVisible="{Binding HasSampleForm}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><views:PlanSampleElectrodesFormView DataContext="{Binding ElectrodeForm}"/></Expander>
   </StackPanel>
   <Grid IsVisible="{Binding InitializingRouting}"><views:PlanRoutingInitializationFormView DataContext="{Binding RoutingInitializationForm}"/></Grid>
   <Grid IsVisible="{Binding CreatingSample}"><views:PlanSampleCreationFormView DataContext="{Binding CreationForm}"/></Grid>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
   <controls:OperatorButton Content="应用修改" Command="{Binding ApplySampleCommand}" AutomationProperties.Name="应用样品资料"/>
   <controls:OperatorButton Content="撤销修改" Command="{Binding DiscardSampleCommand}" AutomationProperties.Name="撤销样品资料"/>
  </StackPanel>
 </Grid>
</UserControl>
