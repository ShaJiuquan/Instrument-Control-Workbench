<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InstrumentControlWorkbench.App.ViewModels"
             xmlns:views="using:InstrumentControlWorkbench.App.Views"
             xmlns:controls="using:InstrumentControlWorkbench.App.Controls"
             x:Class="InstrumentControlWorkbench.App.Views.EventLogView" x:DataType="vm:MainWindowViewModel">
<Border Classes="panel">
  <Grid RowDefinitions="Auto,*">
    <Border Padding="22,16" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="运行事件" Classes="section"/><TextBlock Grid.Column="1" Text="最新事件在前 · 最多保留 200 条" Classes="caption"/></Grid></Border>
    <ListBox Grid.Row="1" ItemsSource="{Binding EventLog}">
      <ListBox.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" Classes="mono" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</Border>
</UserControl>
