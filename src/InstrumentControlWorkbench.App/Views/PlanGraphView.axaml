<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InstrumentControlWorkbench.App.ViewModels" xmlns:controls="using:InstrumentControlWorkbench.App.Controls"
             x:Class="InstrumentControlWorkbench.App.Views.PlanGraphView" x:DataType="vm:PlanWorkspaceViewModel">
  <Grid RowDefinitions="Auto,*,Auto" Margin="8">
    <WrapPanel Margin="0,0,0,8">
      <ComboBox ItemsSource="{Binding PaletteKinds}" SelectedItem="{Binding PaletteKind, Mode=TwoWay}" Width="100" Margin="0,0,6,6" IsEnabled="{Binding CanEditNode}" AutomationProperties.Name="新增步骤类型"/>
      <controls:OperatorButton Content="添加到顺序" Command="{Binding AppendNodeCommand}" Margin="0,0,6,6" AutomationProperties.Name="添加流程步骤"/>
      <controls:OperatorButton Content="删除" Command="{Binding RemoveNodeCommand}" Margin="0,0,6,6" AutomationProperties.Name="删除流程步骤"/>
      <controls:OperatorButton Content="前移" Command="{Binding MoveEarlierCommand}" Margin="0,0,6,6" AutomationProperties.Name="流程步骤前移"/>
      <controls:OperatorButton Content="后移" Command="{Binding MoveLaterCommand}" Margin="0,0,6,6" AutomationProperties.Name="流程步骤后移"/>
    </WrapPanel>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <Grid Width="{Binding GraphWidth}" Height="{Binding GraphHeight}">
        <controls:PlanFlowEdges Nodes="{Binding GraphNodes}" IsHitTestVisible="False"/>
        <ItemsControl ItemsSource="{Binding GraphNodes}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemContainerTheme><ControlTheme TargetType="ContentPresenter" x:DataType="vm:PlanGraphNodeViewModel"><Setter Property="Canvas.Left" Value="{Binding X}"/><Setter Property="Canvas.Top" Value="{Binding Y}"/></ControlTheme></ItemsControl.ItemContainerTheme>
          <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PlanGraphNodeViewModel">
            <controls:OperatorButton Width="220" Height="70" Command="{Binding SelectCommand}" Classes="flowNode" Classes.selected="{Binding IsSelected}" Classes.active="{Binding IsActive}" HorizontalContentAlignment="Stretch" ToolTip.Tip="{Binding Detail}">
              <StackPanel Spacing="3"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Title}" FontSize="12"/><TextBlock Grid.Column="1" Text="{Binding Relation}" FontSize="9" Classes="caption"/></Grid><TextBlock Text="{Binding Detail}" FontSize="10" Classes="caption" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Id.Value}" FontSize="9" Classes="caption" TextTrimming="CharacterEllipsis"/></StackPanel>
            </controls:OperatorButton>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </ScrollViewer>
    <TextBlock Grid.Row="2" Text="连线表示计划层级；同一顺序中的步骤按编号执行。选择节点后在节点参数页编辑。" Classes="caption" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
  </Grid>
  <UserControl.Styles>
    <Style Selector="Button.flowNode"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="Button.flowNode.selected"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="BorderThickness" Value="2"/></Style>
    <Style Selector="Button.flowNode.active"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/></Style>
  </UserControl.Styles>
</UserControl>
