<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:InstrumentControlWorkbench.App.ViewModels" xmlns:views="using:InstrumentControlWorkbench.App.Views"
 x:Class="InstrumentControlWorkbench.App.Views.PlanConditionFormView" x:DataType="vm:PlanConditionFormViewModel">
 <StackPanel Spacing="8">
  <views:PlanVariablePickerView DataContext="{Binding VariablePicker}"/>
  <TextBlock Text="条件左侧变量 ID（可手填）" Classes="caption"/><TextBox Text="{Binding Variable, Mode=TwoWay}" IsReadOnly="{Binding IsReadOnly}" AutomationProperties.Name="条件变量"/>
  <TextBlock Text="比较运算" Classes="caption"/><ComboBox ItemsSource="{Binding Comparisons}" SelectedItem="{Binding Comparison, Mode=TwoWay}" IsEnabled="{Binding !IsReadOnly}" HorizontalAlignment="Stretch" AutomationProperties.Name="条件运算"/>
  <TextBlock Text="比较右侧值" Classes="caption"/><views:PlanValueFormView DataContext="{Binding Value}"/>
  <Expander Header="相等容差" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" FontSize="11">
   <StackPanel Spacing="6" Margin="0,8,0,0">
    <CheckBox Content="指定相等或不等的容差" IsChecked="{Binding UseTolerance, Mode=TwoWay}" IsEnabled="{Binding !IsReadOnly}" AutomationProperties.Name="指定条件容差"/>
    <TextBox Text="{Binding ToleranceText, Mode=TwoWay}" IsReadOnly="{Binding !CanEditTolerance}" AutomationProperties.Name="条件容差"/>
    <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding ToleranceUnit, Mode=TwoWay}" IsEnabled="{Binding CanEditTolerance}" HorizontalAlignment="Stretch" AutomationProperties.Name="条件容差单位"/>
    <TextBlock Text="仅正的同单位数值容差可用于 Equal / NotEqual；布尔和文本支持 Equal / NotEqual。" Classes="caption" FontSize="10" TextWrapping="Wrap"/>
   </StackPanel>
  </Expander>
 </StackPanel>
</UserControl>
