<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:InstrumentControlWorkbench.App.ViewModels"
 x:Class="InstrumentControlWorkbench.App.Views.PlanSampleElectrodesFormView" x:DataType="vm:PlanSampleElectrodesFormViewModel">
 <StackPanel Spacing="8">
  <TextBlock Text="验证接线 / 应用时检查全部必需方向" Classes="caption" TextWrapping="Wrap"/>
  <ComboBox ItemsSource="{Binding Wirings}" SelectedItem="{Binding SelectedWiring, Mode=TwoWay}" IsEnabled="{Binding !IsReadOnly}" HorizontalAlignment="Stretch" AutomationProperties.Name="样品验证接线">
   <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:PlanWiringChoice"><TextBlock Text="{Binding Label}" FontSize="11" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
  </ComboBox>
  <CheckBox Content="同步内部独立源路由保护" IsChecked="{Binding CoordinateIndependentRoutes, Mode=TwoWay}" IsVisible="{Binding AllowGuardCoordination}" IsEnabled="{Binding CanCoordinateGuards}" AutomationProperties.Name="同步样品内部路由保护"/>
  <TextBlock IsVisible="{Binding AllowGuardCoordination}" Text="启用后只协调本样品内部独立源采集的对应保护；源、表、阈值与重试保持原值，独立矩阵步骤不会被改写。" Classes="caption" FontSize="10" TextWrapping="Wrap"/>
  <ItemsControl ItemsSource="{Binding Electrodes}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PlanElectrodeFormViewModel">
   <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8"><StackPanel Spacing="6">
    <TextBlock Text="{Binding Label.Value}" Classes="caption"/>
    <ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel, Mode=TwoWay}" IsEnabled="{Binding !IsReadOnly}" HorizontalAlignment="Stretch" AutomationProperties.Name="电极通道">
     <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:PlanChannelChoice"><TextBlock Text="{Binding Label}" FontSize="11" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox>
    <ComboBox ItemsSource="{Binding Connections}" SelectedItem="{Binding SelectedConnection, Mode=TwoWay}" IsEnabled="{Binding !IsReadOnly}" HorizontalAlignment="Stretch" AutomationProperties.Name="电极连接点">
     <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:PlanConnectionChoice"><TextBlock Text="{Binding Label}" FontSize="11" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox>
    <CheckBox Content="启用电极" IsChecked="{Binding Enabled, Mode=TwoWay}" IsEnabled="{Binding !IsReadOnly}"/>
    <TextBox Text="{Binding Notes, Mode=TwoWay}" IsReadOnly="{Binding IsReadOnly}" Watermark="电极备注" AutomationProperties.Name="电极备注"/>
   </StackPanel></Border>
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <TextBlock Text="切换通道会清空连接点；必需方向中的电极必须启用。接线用于验证；未启用同步时不会改写测量步骤。" Classes="caption" FontSize="10" TextWrapping="Wrap"/>
 </StackPanel>
</UserControl>
